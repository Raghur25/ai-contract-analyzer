# Copy this file to .env and fill in your own values. Never commit .env.

# MongoDB connection string (username and password must match the MONGO_ROOT_* values below)
MONGODB_URI=mongodb://username:password@localhost:27017/?authSource=admin

# Google Gemini API key - get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Required by docker-compose.yml - choose your own values
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=
MONGO_EXPRESS_USERNAME=
MONGO_EXPRESS_PASSWORD=
